function updateEnglishPriceOptions() {

    const priceType =
        document.getElementById(
            "englishPriceType"
        ).value;


    const priceSelect =
        document.getElementById(
            "englishPrice"
        );


    priceSelect.innerHTML = "";


    const allOption =
        document.createElement("option");


    allOption.value = "all";

    allOption.textContent = "Price";


    priceSelect.appendChild(allOption);


    const selectedType =
        priceType === "all"
            ? "total"
            : priceType;


    const ranges =
        englishPriceRanges[selectedType];


    ranges.forEach(function(range) {

        const option =
            document.createElement("option");

        option.value =
            range.value;

        option.textContent =
            range.text;

        priceSelect.appendChild(option);

    });

}


function englishPriceMatches(
    price,
    priceType,
    selectedRange
) {

    if (selectedRange === "all") {
        return true;
    }


    const ranges =
        englishPriceRanges[priceType];


    if (!ranges) {
        return true;
    }


    const range =
        ranges.find(function(item) {

            return item.value === selectedRange;

        });


    if (!range) {
        return true;
    }


    const numericPrice =
        Number(price);


    if (Number.isNaN(numericPrice)) {
        return false;
    }


    return (
        numericPrice >= range.min &&
        numericPrice < range.max
    );

}


function formatEnglishPrice(property) {

    if (
        property.price === null ||
        property.price === undefined ||
        property.price === ""
    ) {

        return "";

    }


    const price =
        Number(property.price);


    if (Number.isNaN(price)) {
        return "";
    }


    let text =
        price.toLocaleString("en-US") +
        " EGP";


    const priceType =
        getPriceType(property);


    if (priceType === "meter") {

        text += " / m²";

    } else if (priceType === "monthly") {

        text += " / Month";

    } else if (priceType === "yearly") {

        text += " / Year";

    }


    if (
        property.price_note &&
        String(property.price_note).trim() !== ""
    ) {

        text +=
            " " +
            String(property.price_note).trim();

    }


    return text;

}


function getFirstPropertyImage(property) {

    const possibleImages = [
        property.images,
        property.image_urls,
        property.imageUrls,
        property.image_url,
        property.imageUrl,
        property.image,
        property.photo,
        property.photos
    ];


    for (const value of possibleImages) {

        if (!value) {
            continue;
        }


        if (Array.isArray(value)) {

            if (value.length > 0 && value[0]) {
                return String(value[0]);
            }

            continue;
        }


        if (typeof value === "string") {

            const trimmed =
                value.trim();


            if (!trimmed) {
                continue;
            }


            try {

                const parsed =
                    JSON.parse(trimmed);


                if (
                    Array.isArray(parsed) &&
                    parsed.length > 0
                ) {

                    return String(parsed[0]);

                }

            } catch (error) {
                // Not JSON, continue below.
            }


            if (trimmed.includes(",")) {

                const first =
                    trimmed
                        .split(",")
                        .map(item => item.trim())
                        .find(Boolean);


                if (first) {
                    return first;
                }

            }


            return trimmed;

        }

    }


    return "";

}


async function loadEnglishProperties() {

    const container =
        document.getElementById(
            "englishPropertiesContainer"
        );


    const loading =
        document.getElementById(
            "englishLoading"
        );


    try {

        const { data, error } =
            await supabaseClient
                .from("properties")
                .select("*")
                .order("created_at", {
                    ascending: false
                });


        if (error) {

            console.error(
                "Error loading properties:",
                error
            );


            loading.textContent =
                "Could not load properties.";

            return;

        }


        allEnglishProperties =
            data || [];


        loading.style.display =
            "none";


        displayEnglishProperties(
            allEnglishProperties
        );


    } catch (error) {

        console.error(error);


        loading.textContent =
            "Could not load properties.";

    }

}


