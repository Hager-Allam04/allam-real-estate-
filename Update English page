            statusText = "For Sale";

        } else if (statusText === "للإيجار") {

            statusText = "For Rent";

        } else if (statusText === "تم البيع") {

            statusText = "Sold";

        } else if (statusText === "تم التأجير") {

            statusText = "Rented";

        }


        const type =
            property.property_type_en || "";


        const location =
            property.location_en || "";


        const title =
            property.title_en ||
            (
                type +
                (
                    location
                        ? " in " + location
                        : ""
                )
            );


        const priceText =
            formatEnglishPrice(property);


        let details = [];


        if (
            property.rooms !== null &&
            property.rooms !== undefined &&
            property.rooms !== ""
        ) {

            details.push(
                property.rooms +
                (
                    Number(property.rooms) === 1
                        ? " Bedroom"
                        : " Bedrooms"
                )
            );

        }


        if (
            property.bathrooms !== null &&
            property.bathrooms !== undefined &&
            property.bathrooms !== ""
        ) {

            details.push(
                property.bathrooms +
                (
                    Number(property.bathrooms) === 1
                        ? " Bathroom"
                        : " Bathrooms"
                )
            );

        }


        if (
            property.area !== null &&
            property.area !== undefined &&
            property.area !== ""
        ) {

            details.push(
                property.area +
                " m²"
            );

        }


        if (
            property.floor !== null &&
            property.floor !== undefined &&
            property.floor !== ""
        ) {

            details.push(
                "Floor " +
                property.floor
            );

        }


        const imageHTML =
            image
                ? `
                    <img
                        src="${image}"
                        alt="${title}"
                        onerror="this.remove();"
                    >
                `
                : "";


        card.innerHTML = `

            <div class="property-image">

                ${imageHTML}

            </div>


            <div class="property-info">

                <span>
                    ${statusText}
                </span>


                <h3>
                    ${title}
                </h3>


                <p>
                    ${details.join(" • ")}
                </p>


                <strong>
                    ${priceText}
                </strong>

            </div>

        `;


        container.appendChild(card);

    });

}


