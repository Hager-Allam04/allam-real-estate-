        noResults.style.display =
            "block";

        return;

    }


    noResults.style.display =
        "none";


    properties.forEach(function(property) {

        const card =
            document.createElement("div");


        card.className =
            "property-card";


        const propertyId =
            getPropertyId(property);


        card.onclick = function() {

            openPropertyDetails(
                propertyId
