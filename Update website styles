/* =========================================================
   ALLAM REAL ESTATE
   Sophisticated Modern Luxury Color System
   ========================================================= */


/* =========================================================
   1. DESIGN SYSTEM
   ========================================================= */

:root {

    /* Main Palette */
    --bone: #E6E0D6;
    --merlot: #4B1E23;
    --olive: #6B6F4E;
    --midnight-blue: #1C2430;
    --tobacco: #8A5A2B;
    --graphite: #121212;

    /* Semantic Colors */
    --background: var(--bone);
    --surface: var(--bone);
    --surface-dark: var(--midnight-blue);

    --text-dark: var(--graphite);
    --text-medium: var(--midnight-blue);
    --text-light: var(--olive);

    --primary: var(--merlot);
    --secondary: var(--midnight-blue);
    --accent: var(--tobacco);
    --accent-secondary: var(--olive);

    --border: rgba(18, 18, 18, 0.14);

    --shadow-sm:
        0 5px 18px rgba(18, 18, 18, 0.10);

    --shadow-md:
        0 12px 32px rgba(18, 18, 18, 0.14);

    --shadow-lg:
        0 20px 50px rgba(18, 18, 18, 0.18);

    --radius-sm: 9px;
    --radius-md: 16px;
    --radius-lg: 24px;

    --container: 1200px;

    --transition-fast: 0.2s ease;
    --transition: 0.35s ease;
    --transition-slow: 0.6s ease;
}


/* =========================================================
   2. RESET
   ========================================================= */

* {
    box-sizing: border-box;
    margin: 0;
    padding: 0;
}

html {
    scroll-behavior: smooth;
    width: 100%;
}

body {
    width: 100%;
    min-height: 100vh;

    background: var(--bone);
    color: var(--graphite);

    font-family:
        "Cairo",
        "Segoe UI",
        Tahoma,
        Arial,
        sans-serif;

    font-size: 17px;
    line-height: 1.9;

    overflow-x: hidden;

    -webkit-font-smoothing: antialiased;
    text-rendering: optimizeLegibility;
}

img {
    display: block;
    max-width: 100%;
}

a {
    color: inherit;
}

button,
input,
select,
textarea {
    font-family: inherit;
}

button {
    cursor: pointer;
}

::selection {
    background: var(--tobacco);
    color: var(--bone);
}


/* =========================================================
   3. GENERAL TYPOGRAPHY
   ========================================================= */

h1,
h2,
h3,
h4,
h5,
h6 {
    line-height: 1.4;
}

p {
    line-height: 1.9;
}

.section-title {
    margin-bottom: 12px;

    color: var(--graphite);

    font-size:
        clamp(32px, 3vw, 44px);

    font-weight: 800;
    line-height: 1.35;
}

.section-description {
    max-width: 720px;
    margin: 0 auto;

    color: var(--midnight-blue);

    font-size: 18px;
    line-height: 1.9;
}


/* =========================================================
   4. NAVBAR
   ========================================================= */

nav {
    position: relative;
    z-index: 1000;

    width: 100%;
    min-height: 82px;

    display: flex;
    align-items: center;
    justify-content: space-between;

    gap: 30px;

    padding: 14px 5%;

    background:
        linear-gradient(
            135deg,
            var(--graphite),
            var(--midnight-blue)
        );

    color: var(--bone);

    border-bottom:
        1px solid rgba(230, 224, 214, 0.15);

    box-shadow:
        0 4px 20px rgba(18, 18, 18, 0.22);
}


/* اسم المكتب */

nav > div:first-child {
    display: flex;
    align-items: center;

    gap: 12px;

    flex-shrink: 0;
}

nav h1 {
    margin: 0;

    color: var(--bone);

    font-size: 34px;
    font-weight: 800;

    line-height: 1.25;

    white-space: nowrap;
}

nav span {
    color: var(--tobacco);

    font-size: 16px;
    font-weight: 600;

    white-space: nowrap;
}


/* روابط النافبار */

nav > div:last-child {
    display: flex;
    align-items: center;
    justify-content: flex-end;

    flex-wrap: wrap;

    gap: 8px;
}

nav div a {
    position: relative;

    display: inline-flex;
    align-items: center;
    justify-content: center;

    min-height: 44px;

    padding: 11px 16px;

    color: var(--bone);

    text-decoration: none;

    font-size: 18px;
    font-weight: 700;

    border-radius: 9px;

    white-space: nowrap;

    transition:
        color var(--transition),
        background var(--transition),
        transform var(--transition);
}

nav div a::after {
    content: "";

    position: absolute;

    right: 13px;
    left: 13px;
    bottom: 4px;

    height: 2px;

    background: var(--tobacco);

    transform: scaleX(0);

    transform-origin: center;

    transition:
        transform var(--transition);
}

nav div a:hover {
    color: var(--bone);

    background:
        rgba(230, 224, 214, 0.08);

    transform:
        translateY(-2px);
}

nav div a:hover::after {
    transform: scaleX(1);
}

nav div a:focus-visible {
    outline: 2px solid var(--tobacco);
    outline-offset: 3px;
}


/* =========================================================
   5. GENERAL CONTAINERS
   ========================================================= */

.container {
    width:
        min(
            calc(100% - 40px),
            var(--container)
        );

    margin-inline: auto;
}

section {
    width: 100%;
}


/* =========================================================
   6. HERO
   ========================================================= */

.hero {
    position: relative;

    min-height: 590px;

    display: flex;
    align-items: center;
    justify-content: center;

    padding: 90px 20px;

    text-align: center;

    color: var(--bone);

    background:
        linear-gradient(
            135deg,
            rgba(18, 18, 18, 0.92),
            rgba(28, 36, 48, 0.78)
        ),
        url("property1.jpg")
        center / cover no-repeat;

    overflow: hidden;
}

.hero::before {
    content: "";

    position: absolute;
    inset: 0;

    background:
        radial-gradient(
            circle at center,
            transparent 25%,
            rgba(18, 18, 18, 0.25) 100%
        );

    pointer-events: none;
}

.hero::after {
    content: "";

    position: absolute;

    width: 350px;
    height: 350px;

    right: -160px;
    bottom: -180px;

    border-radius: 50%;

    background:
        rgba(138, 90, 43, 0.13);

    animation:
        heroGlow 8s ease-in-out infinite alternate;
}

@keyframes heroGlow {

    from {
        transform:
            translate(0, 0)
            scale(1);
    }

    to {
        transform:
            translate(-40px, -25px)
            scale(1.15);
    }
}

.hero-content {
    position: relative;
    z-index: 2;

    width:
        min(100%, 1000px);

    margin: auto;

    animation:
        heroContent 0.9s ease both;
}

@keyframes heroContent {

    from {
        opacity: 0;

        transform:
            translateY(25px);
    }

    to {
        opacity: 1;

        transform:
            translateY(0);
    }
}

.hero-content h2 {
    max-width: 900px;

    margin:
        0 auto 18px;

    color: var(--bone);

    font-size:
        clamp(42px, 5vw, 64px);

    font-weight: 800;

    line-height: 1.35;

    letter-spacing: -0.5px;
}

.hero-content p {
    max-width: 750px;

    margin:
        0 auto 34px;

    color: var(--bone);

    font-size:
        clamp(18px, 2vw, 22px);

    line-height: 2;
}


/* =========================================================
   7. SEARCH BOX
   ========================================================= */

.search-box {
    position: relative;
    z-index: 5;

    width:
        min(100%, 1080px);

    margin:
        32px auto 0;

    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;

    gap: 12px;

    padding: 20px;

    background: var(--bone);

    border:
        1px solid rgba(18, 18, 18, 0.12);

    border-radius:
        var(--radius-md);

    box-shadow:
        var(--shadow-lg);

    text-align: right;

    animation:
        searchAppear 0.8s 0.15s ease both;
}

@keyframes searchAppear {

    from {
        opacity: 0;

        transform:
            translateY(20px);
    }

    to {
        opacity: 1;

        transform:
            translateY(0);
    }
}

.search-box select,
.search-box input,
.search-box button {
    min-height: 50px;

    border-radius: 10px;

    font-size: 17px;
}

.search-box select,
.search-box input {
    flex: 1 1 165px;

    min-width: 150px;

    padding:
        11px 14px;

    color: var(--graphite);

    background: var(--bone);

    border:
        1px solid var(--border);

    outline: none;

    transition:
        border-color var(--transition),
        box-shadow var(--transition),
        transform var(--transition);
}

.search-box select:hover,
.search-box input:hover {
    border-color:
        var(--tobacco);
}

.search-box select:focus,
.search-box input:focus {
    border-color:
        var(--tobacco);

    box-shadow:
        0 0 0 4px
        rgba(138, 90, 43, 0.15);

    transform:
        translateY(-1px);
}

.search-box button {
    flex: 0 0 auto;

    padding:
        11px 27px;

    color: var(--bone);

    background:
        var(--merlot);

    border: none;

    font-size: 17px;
    font-weight: 800;

    transition:
        transform var(--transition),
        background var(--transition),
        box-shadow var(--transition);
}

.search-box button:hover {
    background:
        var(--graphite);

    transform:
        translateY(-3px);

    box-shadow:
        var(--shadow-sm);
}


/* =========================================================
   8. BUTTONS
   ========================================================= */

.btn,
button {
    transition:
        background var(--transition),
        color var(--transition),
        transform var(--transition),
        box-shadow var(--transition);
}

.btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;

    gap: 8px;

    min-height: 48px;

    padding:
        11px 22px;

    border-radius: 10px;

    text-decoration: none;

    font-size: 17px;
    font-weight: 800;
}

.btn-primary {
    color: var(--bone);

    background:
        var(--merlot);
}

.btn-primary:hover {
    color: var(--bone);

    background:
        var(--graphite);

    transform:
        translateY(-3px);

    box-shadow:
        var(--shadow-sm);
}

.btn-secondary {
    color: var(--graphite);

    background:
        var(--tobacco);
}

.btn-secondary:hover {
    color: var(--bone);

    background:
        var(--merlot);

    transform:
        translateY(-3px);

    box-shadow:
        var(--shadow-sm);
}

.btn-dark {
    color: var(--bone);

    background:
        var(--midnight-blue);
}

.btn-dark:hover {
    background:
        var(--graphite);

    transform:
        translateY(-3px);

    box-shadow:
        var(--shadow-sm);
}


/* =========================================================
   9. FEATURED PROPERTIES
   ========================================================= */

.featured-properties {
    padding:
        85px 20px;

    text-align: center;
}

.featured-properties > h2 {
    margin-bottom: 10px;

    color:
        var(--graphite);

    font-size:
        clamp(34px, 4vw, 44px);

    font-weight: 800;
}

.featured-properties > p {
    max-width: 720px;

    margin:
        0 auto;

    color:
        var(--midnight-blue);

    font-size: 18px;
}

.properties-container {
    width:
        min(
            100%,
            var(--container)
        );

    display: grid;

    grid-template-columns:
        repeat(3, minmax(0, 1fr));

    gap: 28px;

    margin:
        45px auto 0;

    padding: 0;
}


/* =========================================================
   10. PROPERTY CARD
   ========================================================= */

.property-card {
    position: relative;

    display: flex;
    flex-direction: column;

    min-width: 0;
    min-height: 100%;

    overflow: hidden;

    background:
        var(--bone);

    border:
        1px solid
        rgba(18, 18, 18, 0.10);

    border-radius:
        var(--radius-md);

    box-shadow:
        var(--shadow-sm);

    text-align: right;

    cursor: pointer;

    transition:
        transform 0.4s ease,
        box-shadow 0.4s ease,
        border-color 0.4s ease;
}

.property-card::before {
    content: "";

    position: absolute;

    top: 0;
    right: 0;
    left: 0;

    height: 3px;

    background:
        linear-gradient(
            90deg,
            var(--merlot),
            var(--tobacco),
            var(--olive)
        );

    transform:
        scaleX(0);

    transform-origin:
        center;

    transition:
        transform 0.4s ease;

    z-index: 3;
}

.property-card:hover {
    transform:
        translateY(-9px);

    border-color:
        var(--tobacco);

    box-shadow:
        var(--shadow-lg);
}

.property-card:hover::before {
    transform:
        scaleX(1);
}


/* =========================================================
   11. PROPERTY IMAGE
   ========================================================= */

.property-image {
    position: relative;

    width: 100%;
    height: 245px;

    overflow: hidden;

    background:
        var(--midnight-blue);
}

.property-image img {
    width: 100%;
    height: 100%;

    object-fit: cover;

    transition:
        transform 0.7s ease,
        filter 0.5s ease;
}

.property-card:hover
.property-image img {
    transform:
        scale(1.06);
}

.property-image.placeholder,
.property-placeholder {
    display: flex;

    align-items: center;
    justify-content: center;

    min-height: 245px;

    padding: 20px;

    color:
        var(--bone);

    background:
        var(--midnight-blue);

    text-align: center;
}

.property-placeholder span {
    font-size: 15px;
    font-weight: 700;
}


/* =========================================================
   12. PROPERTY INFO
   ========================================================= */

.property-info {
    display: flex;
    flex-direction: column;

    flex: 1;

    padding: 22px;
}

.property-info > span {
    align-self: flex-start;

    display: inline-flex;
    align-items: center;

    width: fit-content;

    margin-bottom: 11px;

    padding:
        5px 12px;

    color:
        var(--bone);

    background:
        var(--olive);

    border-radius:
        20px;

    font-size: 14px;
    font-weight: 800;
}

.property-info h3 {
    margin-bottom: 10px;

    color:
        var(--graphite);

    font-size: 23px;
    font-weight: 800;

    line-height: 1.6;
}

.property-info p {
    margin-bottom: 10px;

    color:
        var(--midnight-blue);

    font-size: 16px;

    line-height: 1.9;
}

.property-info strong {
    display: block;

    margin-top: auto;

    padding-top: 10px;

    color:
        var(--tobacco);

    font-size: 24px;
    font-weight: 800;
}


/* =========================================================
   13. PROPERTY META
   ========================================================= */

.property-meta,
.property-features {
    display: flex;

    flex-wrap: wrap;

    gap:
        9px 17px;

    margin:
        11px 0;
}

.property-meta span,
.property-features span {
    color:
        var(--olive);

    font-size: 15px;
}


/* =========================================================
   14. NO RESULTS
   ========================================================= */

#noResults,
.no-results {
    width:
        min(100%, 650px);

    margin:
        40px auto 0;

    padding:
        32px 22px;

    color:
        var(--midnight-blue);

    background:
        var(--bone);

    border:
        1px dashed
        var(--olive);

    border-radius:
        var(--radius-md);

    text-align: center;

    box-shadow:
        var(--shadow-sm);
}

#noResults h3,
.no-results h3 {
    margin-bottom: 9px;

    color:
        var(--graphite);

    font-size: 21px;
}

#noResults p,
.no-results p {
    font-size: 16px;
}


/* =========================================================
   15. PROPERTY DETAILS
   ========================================================= */

.property-details {
    width:
        min(
            calc(100% - 40px),
            1150px
        );

    margin:
        65px auto;

    display: grid;

    grid-template-columns:
        minmax(0, 1.1fr)
        minmax(320px, 0.9fr);

    gap: 50px;

    align-items: start;
}

.property-gallery {
    min-width: 0;
}

.main-property-image {
    width: 100%;
    height: 500px;

    object-fit: cover;

    background:
        var(--midnight-blue);

    border-radius:
        var(--radius-md);

    box-shadow:
        var(--shadow-md);

    transition:
        transform var(--transition),
        box-shadow var(--transition);
}

.main-property-image:hover {
    box-shadow:
        var(--shadow-lg);
}

.property-thumbnails {
    display: flex;

    gap: 11px;

    margin-top: 14px;

    padding-bottom: 5px;

    overflow-x: auto;
}

.property-thumbnails img {
    flex:
        0 0 auto;

    width: 88px;
    height: 68px;

    object-fit: cover;

    border:
        2px solid transparent;

    border-radius: 9px;

    cursor: pointer;

    opacity: 0.72;

    transition:
        opacity var(--transition),
        border-color var(--transition),
        transform var(--transition);
}

.property-thumbnails img:hover {
    opacity: 1;

    transform:
        translateY(-3px);
}

.property-thumbnails img.active {
    opacity: 1;

    border-color:
        var(--tobacco);
}

.details-info {
    padding:
        5px 0;
}

.details-info h2 {
    margin-bottom: 13px;

    color:
        var(--graphite);

    font-size:
        clamp(32px, 4vw, 44px);

    font-weight: 800;

    line-height: 1.45;
}

.details-info strong {
    display: block;

    margin-bottom: 24px;

    color:
        var(--tobacco);

    font-size: 30px;

    font-weight: 800;
}

.details-info p {
    margin-bottom: 15px;

    color:
        var(--midnight-blue);

    font-size: 17px;

    line-height: 2;
}

.details-info .status,
.property-status {
    display: inline-flex;

    width: fit-content;

    margin-bottom: 13px;

    padding:
        6px 14px;

    color:
        var(--bone);

    background:
        var(--merlot);

    border-radius:
        20px;

    font-size: 15px;

    font-weight: 800;
}


/* =========================================================
   16. DETAILS GRID
   ========================================================= */

.property-data,
.details-grid {
    display: grid;

    grid-template-columns:
        repeat(2, minmax(0, 1fr));

    gap: 11px;

    margin:
        27px 0;
}

.property-data > div,
.details-grid > div {
    padding: 15px;

    background:
        var(--bone);

    border:
        1px solid
        var(--border);

    border-radius: 10px;

    transition:
        transform var(--transition),
        border-color var(--transition),
        box-shadow var(--transition);
}

.property-data > div:hover,
.details-grid > div:hover {
    transform:
        translateY(-2px);

    border-color:
        var(--tobacco);

    box-shadow:
        var(--shadow-sm);
}

.property-data strong,
.details-grid strong {
    display: block;

    margin-bottom: 4px;

    color:
        var(--merlot);

    font-size: 15px;
}

.property-data span,
.details-grid span {
    color:
        var(--graphite);

    font-size: 16px;
}


/* =========================================================
   17. DETAILS BUTTONS
   ========================================================= */

.details-buttons {
    display: flex;

    flex-wrap: wrap;

    gap: 11px;

    margin-top: 30px;
}

.details-buttons a,
.details-buttons button {
    display: inline-flex;

    align-items: center;
    justify-content: center;

    min-height: 48px;

    padding:
        11px 20px;

    color:
        var(--bone);

    background:
        var(--midnight-blue);

    border: none;

    border-radius: 10px;

    text-decoration: none;

    font-size: 16px;
    font-weight: 800;

    transition:
        background var(--transition),
        transform var(--transition),
        box-shadow var(--transition);
}

.details-buttons a:hover,
.details-buttons button:hover {
    background:
        var(--merlot);

    transform:
        translateY(-3px);

    box-shadow:
        var(--shadow-sm);
}

.details-buttons .whatsapp,
.whatsapp-button {
    background:
        var(--olive);
}

.details-buttons .whatsapp:hover,
.whatsapp-button:hover {
    background:
        var(--midnight-blue);
}


/* =========================================================
   18. CONTACT PAGE
   ========================================================= */

.contact-page {
    background:
        var(--bone);
}

.contact-hero {
    position: relative;

    min-height: 520px;

    display: flex;
    align-items: center;
    justify-content: center;

    padding:
        85px 20px;

    color:
        var(--bone);

    text-align: center;

    background:
        linear-gradient(
            135deg,
            rgba(18, 18, 18, 0.92),
            rgba(28, 36, 48, 0.78)
        ),
        var(
            --contact-hero-image,
            url("property1.jpg")
        )
        center / cover no-repeat;

    overflow: hidden;
}

.contact-hero-content {
    position: relative;
    z-index: 2;

    width:
        min(100%, 850px);

    animation:
        heroContent 0.9s ease both;
}

.contact-hero h1,
.contact-hero h2 {
    margin-bottom: 14px;

    color:
        var(--bone);

    font-size:
        clamp(42px, 5vw, 60px);

    font-weight: 800;
}

.contact-hero p {
    max-width: 720px;

    margin:
        0 auto;

    color:
        var(--bone);

    font-size: 19px;

    line-height: 1.9;
}

.contact-section {
    width:
        min(
            calc(100% - 40px),
            var(--container)
        );

    margin:
        70px auto;
}

.contact-grid {
    display: grid;

    grid-template-columns:
        minmax(0, 1.15fr)
        minmax(300px, 0.85fr);

    gap: 32px;
}

.contact-form-card,
.contact-info-card,
.info-card,
.map-card {
    background:
        var(--bone);

    border:
        1px solid
        rgba(18, 18, 18, 0.10);

    border-radius:
        var(--radius-md);

    box-shadow:
        var(--shadow-sm);
}

.contact-form-card,
.contact-info-card {
    padding: 32px;
}

.contact-form-card h2,
.contact-info-card h2 {
    margin-bottom: 11px;

    color:
        var(--graphite);

    font-size: 28px;
    font-weight: 800;
}

.contact-form-card > p,
.contact-info-card > p {
    margin-bottom: 27px;

    color:
        var(--midnight-blue);

    font-size: 17px;
}


/* =========================================================
   19. FORM
   ========================================================= */

.form-group {
    margin-bottom: 18px;
}

.form-group label {
    display: block;

    margin-bottom: 7px;

    color:
        var(--merlot);

    font-size: 16px;
    font-weight: 800;
}

.form-group input,
.form-group select,
.form-group textarea {
    width: 100%;

    padding:
        13px 14px;

    color:
        var(--graphite);

    background:
        var(--bone);

    border:
        1px solid
        var(--border);

    border-radius: 10px;

    outline: none;

    font-size: 17px;

    transition:
        border-color var(--transition),
        box-shadow var(--transition),
        background var(--transition);
}

.form-group input,
.form-group select {
    min-height: 48px;
}

.form-group textarea {
    min-height: 145px;

    resize: vertical;
}

.form-group input:focus,
.form-group select:focus,
.form-group textarea:focus {
    background:
        var(--bone);

    border-color:
        var(--tobacco);

    box-shadow:
        0 0 0 4px
        rgba(138, 90, 43, 0.13);
}

.contact-submit {
    width: 100%;

    min-height: 50px;

    padding:
        12px 20px;

    color:
        var(--bone);

    background:
        var(--merlot);

    border: none;

    border-radius: 10px;

    font-size: 17px;
    font-weight: 800;

    transition:
        background var(--transition),
        transform var(--transition),
        box-shadow var(--transition);
}

.contact-submit:hover {
    background:
        var(--graphite);

    transform:
        translateY(-3px);

    box-shadow:
        var(--shadow-sm);
}


/* =========================================================
   20. CONTACT ITEMS
   ========================================================= */

.contact-item {
    display: flex;

    align-items: flex-start;

    gap: 13px;

    margin-bottom: 19px;

    padding-bottom: 18px;

    border-bottom:
        1px solid
        var(--border);
}

.contact-item:last-child {
    margin-bottom: 0;

    padding-bottom: 0;

    border-bottom: none;
}

.contact-item-icon {
    flex:
        0 0 42px;

    width: 42px;
    height: 42px;

    display: flex;

    align-items: center;
    justify-content: center;

    color:
        var(--bone);

    background:
        var(--merlot);

    border-radius: 50%;

    transition:
        transform var(--transition),
        background var(--transition);
}

.contact-item:hover
.contact-item-icon {
    background:
        var(--olive);

    transform:
        scale(1.06)
        rotate(-4deg);
}

.contact-item h3 {
    margin-bottom: 3px;

    color:
        var(--graphite);

    font-size: 17px;
}

.contact-item p,
.contact-item a {
    color:
        var(--midnight-blue);

    font-size: 16px;

    text-decoration: none;
}

.contact-item a:hover {
    color:
        var(--tobacco);
}


/* =========================================================
   21. CONTACT INFO CARDS
   ========================================================= */

.contact-info-cards {
    display: grid;

    grid-template-columns:
        repeat(3, minmax(0, 1fr));

    gap: 20px;

    margin-top: 27px;
}

.info-card {
    padding: 27px;

    text-align: center;

    transition:
        transform var(--transition),
        box-shadow var(--transition);
}

.info-card:hover {
    transform:
        translateY(-5px);

    box-shadow:
        var(--shadow-md);
}

.info-card .icon {
    width: 50px;
    height: 50px;

    display: flex;

    align-items: center;
    justify-content: center;

    margin:
        0 auto 14px;

    color:
        var(--bone);

    background:
        var(--midnight-blue);

    border-radius: 50%;
}

.info-card h3 {
    margin-bottom: 8px;

    color:
        var(--graphite);

    font-size: 20px;
}

.info-card p,
.info-card a {
    color:
        var(--midnight-blue);

    font-size: 16px;

    text-decoration: none;
}


/* =========================================================
   22. MAP
   ========================================================= */

.map-section {
    width:
        min(
            calc(100% - 40px),
            var(--container)
        );

    margin:
        0 auto 70px;
}

.map-section h2 {
    margin-bottom: 8px;

    color:
        var(--graphite);

    font-size: 30px;

    font-weight: 800;
}

.map-section > p {
    margin-bottom: 21px;

    color:
        var(--midnight-blue);

    font-size: 16px;
}

.map-card {
    min-height: 350px;

    overflow: hidden;

    display: flex;

    align-items: center;
    justify-content: center;

    padding: 20px;

    background:
        var(--bone);

    text-align: center;
}

.map-card iframe {
    width: 100%;

    min-height: 400px;

    border: 0;

    border-radius: 12px;
}

.map-placeholder {
    max-width: 550px;

    padding: 30px;
}

.map-placeholder h3 {
    margin-bottom: 8px;

    color:
        var(--merlot);

    font-size: 21px;
}

.map-placeholder p {
    color:
        var(--midnight-blue);

    font-size: 16px;
}


/* =========================================================
   23. CTA
   ========================================================= */

.cta-section {
    width:
        min(
            calc(100% - 40px),
            var(--container)
        );

    margin:
        0 auto 75px;

    padding:
        50px 30px;

    color:
        var(--bone);

    background:
        linear-gradient(
            135deg,
            var(--graphite),
            var(--midnight-blue)
        );

    border-radius:
        var(--radius-lg);

    text-align: center;

    box-shadow:
        var(--shadow-md);

    position: relative;

    overflow: hidden;
}

.cta-section::before {
    content: "";

    position: absolute;

    width: 260px;
    height: 260px;

    top: -150px;
    left: -100px;

    border-radius: 50%;

    background:
        rgba(138, 90, 43, 0.12);

    animation:
        heroGlow 9s ease-in-out infinite alternate;
}

.cta-section h2,
.cta-section p,
.cta-buttons {
    position: relative;
    z-index: 2;
}

.cta-section h2 {
    margin-bottom: 10px;

    color:
        var(--bone);

    font-size:
        clamp(30px, 4vw, 40px);
}

.cta-section p {
    max-width: 650px;

    margin:
        0 auto 24px;

    color:
        var(--bone);

    font-size: 17px;
}

.cta-buttons {
    display: flex;

    justify-content: center;

    flex-wrap: wrap;

    gap: 11px;
}


/* =========================================================
   24. ABOUT
   ========================================================= */

.about-section {
    width:
        min(
            calc(100% - 40px),
            900px
        );

    margin:
        70px auto;

    padding: 45px;

    background:
        var(--bone);

    border:
        1px solid
        rgba(18, 18, 18, 0.10);

    border-radius:
        var(--radius-md);

    box-shadow:
        var(--shadow-sm);
}

.about-section h2 {
    margin-bottom: 14px;

    color:
        var(--graphite);

    font-size: 36px;
}

.about-section h3 {
    margin-bottom: 15px;

    color:
        var(--merlot);

    font-size: 25px;
}

.about-section p {
    margin-bottom: 16px;

    color:
        var(--midnight-blue);

    font-size: 18px;

    line-height: 2;
}

.about-section strong {
    color:
        var(--merlot);
}


/* =========================================================
   25. LOGIN / ADMIN
   ========================================================= */

.login-container {
    width:
        min(
            calc(100% - 40px),
            450px
        );

    margin:
        85px auto;

    padding: 38px;

    background:
        var(--bone);

    border:
        1px solid
        rgba(18, 18, 18, 0.10);

    border-radius:
        var(--radius-md);

    box-shadow:
        var(--shadow-md);
}

.login-container h2 {
    margin-bottom: 27px;

    color:
        var(--merlot);

    font-size: 27px;

    text-align: center;
}

.login-button {
    width: 100%;

    min-height: 50px;

    padding:
        12px 20px;

    color:
        var(--bone);

    background:
        var(--merlot);

    border: none;

    border-radius: 10px;

    font-size: 17px;
    font-weight: 800;
}

.login-button:hover {
    background:
        var(--graphite);

    transform:
        translateY(-3px);

    box-shadow:
        var(--shadow-sm);
}

#errorMessage {
    display: none;

    margin-bottom: 20px;

    padding:
        13px 15px;

    color:
        var(--merlot);

    background:
        var(--bone);

    border:
        1px solid
        var(--merlot);

    border-radius: 9px;

    text-align: center;

    font-size: 16px;
}


/* =========================================================
   26. ADMIN GENERAL
   ========================================================= */

.admin-page {
    background:
        var(--bone);
}

.admin-container {
    width:
        min(
            calc(100% - 40px),
            1200px
        );

    margin:
        45px auto;
}

.admin-card {
    background:
        var(--bone);

    border:
        1px solid
        rgba(18, 18, 18, 0.10);

    border-radius:
        var(--radius-md);

    box-shadow:
        var(--shadow-sm);
}


/* =========================================================
   27. FOOTER
   ========================================================= */

.site-footer {
    margin-top: 75px;

    padding:
        60px 20px 22px;

    color:
        var(--bone);

    background:
        linear-gradient(
            135deg,
            var(--graphite),
            var(--midnight-blue)
        );
}

.footer-content {
    width:
        min(
            100%,
            var(--container)
        );

    margin:
        0 auto 38px;

    display: grid;

    grid-template-columns:
        1.3fr 1fr 1fr;

    gap: 45px;
}

.footer-content h3 {
    margin-bottom: 15px;

    color:
        var(--tobacco);

    font-size: 21px;

    font-weight: 800;
}

.footer-content p,
.footer-content a {
    display: block;

    margin-bottom: 9px;

    color:
        var(--bone);

    font-size: 16px;

    text-decoration: none;

    line-height: 1.9;

    transition:
        color var(--transition),
        transform var(--transition);
}

.footer-content a:hover {
    color:
        var(--tobacco);

    transform:
        translateX(-3px);
}

.footer-about p {
    max-width: 350px;
}

.footer-bottom {
    width:
        min(
            100%,
            var(--container)
        );

    margin:
        0 auto;

    padding-top: 19px;

    border-top:
        1px solid
        rgba(230, 224, 214, 0.16);

    color:
        var(--bone);

    font-size: 14px;

    text-align: center;
}


/* =========================================================
   28. LOADING
   ========================================================= */

.loading,
#loadingText {
    padding:
        40px 20px;

    color:
        var(--midnight-blue);

    font-size: 17px;

    text-align: center;
}


/* =========================================================
   29. ERROR / SUCCESS
   ========================================================= */

.success-message {
    padding:
        13px 15px;

    color:
        var(--olive);

    background:
        var(--bone);

    border:
        1px solid
        var(--olive);

    border-radius: 9px;

    font-size: 16px;
}

.error-message {
    padding:
        13px 15px;

    color:
        var(--merlot);

    background:
        var(--bone);

    border:
        1px solid
        var(--merlot);

    border-radius: 9px;

    font-size: 16px;
}


/* =========================================================
   30. ACCESSIBILITY
   ========================================================= */

a:focus-visible,
button:focus-visible,
input:focus-visible,
select:focus-visible,
textarea:focus-visible {
    outline:
        2px solid
        var(--tobacco);

    outline-offset: 3px;
}


/* =========================================================
   31. LARGE SCREENS
   ========================================================= */

@media (min-width: 1400px) {

    nav {
        padding-inline: 7%;
    }

    nav h1 {
        font-size: 34px;
    }

    nav div a {
        font-size: 18px;
    }

