/* =========================================================
   37. LTR ENGLISH SUPPORT
   ========================================================= */

html[dir="ltr"] body {
    direction: ltr;
}

html[dir="ltr"] nav div a {
    margin-right: 0;
    margin-left: 0;
}

html[dir="ltr"] .property-card,
html[dir="ltr"] .search-box {
    text-align: left;
}

html[dir="ltr"] .property-info > span {
    align-self: flex-start;
}

html[dir="ltr"] .footer-content {
    text-align: left;
}


/* =========================================================
   38. REDUCED MOTION
   ========================================================= */

@media (prefers-reduced-motion: reduce) {

    html {
        scroll-behavior: auto;
    }

    *,
    *::before,
    *::after {
        transition-duration:
            0.01ms !important;

        animation-duration:
            0.01ms !important;

        animation-iteration-count:
            1 !important;
    }
}

/* =========================================================
   ALLAM REAL ESTATE
   PROFESSIONAL UI SIZE & BUTTON UPGRADE
   ========================================================= */

/* =========================================================
   1. GENERAL TYPOGRAPHY
   ========================================================= */

body {
    font-size: 18px;
    line-height: 1.95;
}

p {
    line-height: 1.95;
}

.section-title {
    font-size: clamp(34px, 3.2vw, 48px);
    line-height: 1.35;
    margin-bottom: 16px;
}

.section-description {
    font-size: 19px;
    line-height: 1.95;
}


/* =========================================================
   2. NAVBAR
   ========================================================= */

nav {
    min-height: 92px;
    padding: 16px 5%;
    gap: 35px;
