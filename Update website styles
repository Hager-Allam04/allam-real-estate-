    }
}


/* =========================================================
   33. SMALL LAPTOP / TABLET
   ========================================================= */

@media (max-width: 850px) {

    nav {
        gap: 16px;

        padding:
            13px 20px;
    }

    nav h1 {
        font-size: 25px;
    }

    nav span {
        font-size: 13px;
    }

    nav > div:last-child {
        gap: 5px;
    }

    nav div a {
        min-height: 42px;

        padding:
            8px 10px;

        font-size: 15px;
    }

    .search-box {
        gap: 10px;
    }

    .property-details {
        width:
