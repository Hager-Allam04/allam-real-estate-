.property-details {
    margin: 85px auto;
    gap: 60px;
}

.main-property-image {
    height: 570px;
    border-radius: 20px;
}

.property-thumbnails {
    gap: 15px;
}

.property-thumbnails img {
    width: 110px;
    height: 82px;
    border-radius: 11px;
}

.details-info h2 {
    font-size: clamp(39px, 4.2vw, 52px);
}

.details-info strong {
    font-size: 35px;
    margin-bottom: 30px;
}

.details-info p {
    font-size: 19px;
}


/* =========================
   DETAILS GRID
   ========================= */

.property-data,
.details-grid {
    gap: 15px;
    margin: 34px 0;
}

.property-data > div,
.details-grid > div {
    padding: 20px;
    border-radius: 13px;
}

.property-data strong,
.details-grid strong {
    font-size: 17px;
}

.property-data span,
.details-grid span {
    font-size: 18px;
}


/* =========================
   DETAILS BUTTONS
   ========================= */

.details-buttons {
    gap: 15px;
    margin-top: 38px;
}

.details-buttons a,
.details-buttons button {
    min-height: 58px;
    padding: 14px 28px;
    border-radius: 12px;
    font-size: 18px;
}


/* =========================
   CONTACT
   ========================= */

.contact-hero {
    min-height: 610px;
    padding: 110px 30px;
}

.contact-hero h1,
.contact-hero h2 {
    font-size: clamp(50px, 5.5vw, 70px);
}

.contact-hero p {
    font-size: 21px;
}

.contact-section {
    margin-top: 90px;
    margin-bottom: 90px;
}

.contact-grid {
    gap: 42px;
}

.contact-form-card,
.contact-info-card {
    padding: 42px;
    border-radius: 20px;
}

.contact-form-card h2,
.contact-info-card h2 {
    font-size: 34px;
}

.contact-form-card > p,
.contact-info-card > p {
    font-size: 19px;
}


/* =========================
   FORM
   ========================= */

.form-group {
    margin-bottom: 23px;
}

.form-group label {
    font-size: 18px;
}

.form-group input,
.form-group select,
.form-group textarea {
    padding: 17px 18px;
    font-size: 19px;
    border-radius: 12px;
}

.form-group input,
.form-group select {
    min-height: 58px;
}

.form-group textarea {
    min-height: 180px;
}

.contact-submit {
    min-height: 60px;
    font-size: 19px;
    border-radius: 12px;
}


/* =========================
   CONTACT INFO
   ========================= */

.contact-item {
    gap: 18px;
    margin-bottom: 24px;
    padding-bottom: 23px;
}

.contact-item-icon {
    flex: 0 0 52px;
    width: 52px;
    height: 52px;
}

.contact-item h3 {
    font-size: 20px;
}

.contact-item p,
.contact-item a {
    font-size: 18px;
}

.contact-info-cards {
    gap: 26px;
}

.info-card {
    padding: 34px;
    border-radius: 18px;
}

.info-card .icon {
    width: 60px;
    height: 60px;
}

.info-card h3 {
    font-size: 24px;
}

.info-card p,
.info-card a {
    font-size: 18px;
}


/* =========================
   MAP
   ========================= */

.map-section h2 {
    font-size: 36px;
}

.map-section > p {
    font-size: 18px;
}

.map-card {
    min-height: 430px;
    padding: 26px;
    border-radius: 20px;
}

.map-card iframe {
    min-height: 480px;
}


/* =========================
   CTA
   ========================= */

.cta-section {
    margin-bottom: 95px;
    padding: 70px 40px;
    border-radius: 26px;
}

.cta-section h2 {
    font-size: clamp(38px, 4.2vw, 50px);
}

.cta-section p {
    font-size: 19px;
}

.cta-buttons {
    gap: 16px;
}


/* =========================
   ABOUT
   ========================= */

.about-section {
    width: min(calc(100% - 40px), 1000px);
    margin: 90px auto;
    padding: 60px;
    border-radius: 20px;
}

.about-section h2 {
    font-size: 44px;
}

.about-section h3 {
    font-size: 29px;
}

.about-section p {
    font-size: 20px;
}


/* =========================
   FOOTER
   ========================= */

.site-footer {
    margin-top: 100px;
    padding: 78px 25px 28px;
}

.footer-content {
    gap: 55px;
}

.footer-content h3 {
    font-size: 25px;
}

.footer-content p,
.footer-content a {
    font-size: 18px;
}

.footer-bottom {
    font-size: 16px;
}


/* =========================
   MOBILE
   ========================= */

@media (max-width: 700px) {

    body {
        font-size: 18px;
    }

    nav {
        padding: 21px 10px 17px;
    }

    nav h1 {
        font-size: 32px;
    }

    nav span {
        font-size: 15px;
    }

    nav div a {
        min-height: 47px;
        padding: 10px 12px;
        font-size: 17px;
    }

    .hero {
        min-height: 590px;
        padding: 80px 15px;
    }

    .hero-content h2 {
        font-size: 43px;
    }

    .hero-content p {
        font-size: 19px;
    }

    .search-box {
        padding: 19px;
    }

    .search-box select,
    .search-box input,
    .search-box button {
        min-height: 58px;
        font-size: 18px;
    }

    .featured-properties {
        padding: 85px 15px;
    }

    .featured-properties > h2 {
        font-size: 38px;
    }

    .featured-properties > p {
        font-size: 18px;
    }

    .property-image {
        height: 270px;
    }

    .property-info {
        padding: 26px;
    }

    .property-info h3 {
        font-size: 25px;
    }

    .property-info p {
        font-size: 17px;
    }

    .property-info strong {
        font-size: 27px;
    }

    .main-property-image {
        height: min(82vw, 410px);
    }

    .details-info h2 {
        font-size: 35px;
    }

    .details-info strong {
        font-size: 29px;
    }

    .details-info p {
        font-size: 18px;
    }

    .details-buttons a,
    .details-buttons button {
        min-height: 58px;
        font-size: 18px;
    }

    .contact-hero {
        min-height: 540px;
        padding: 80px 15px;
    }

    .contact-hero h1,
    .contact-hero h2 {
        font-size: 44px;
    }

    .contact-hero p {
        font-size: 19px;
    }

    .contact-form-card,
    .contact-info-card {
        padding: 32px 22px;
    }

    .contact-form-card h2,
    .contact-info-card h2 {
        font-size: 30px;
    }

    .form-group input,
    .form-group select,
    .form-group textarea {
        font-size: 18px;
    }

    .about-section {
        padding: 40px 23px;
    }

    .about-section h2 {
        font-size: 36px;
    }

    .about-section p {
        font-size: 18px;
    }

    .cta-section {
        padding: 50px 22px;
    }

    .cta-section h2 {
        font-size: 38px;
    }

    .footer-content h3 {
        font-size: 23px;
    }

    .footer-content p,
    .footer-content a {
        font-size: 17px;
    }
}


/* =========================
   SMALL MOBILE
   ========================= */

@media (max-width: 420px) {

    nav h1 {
        font-size: 29px;
    }

    nav div a {
        min-height: 44px;
        padding: 9px 9px;
        font-size: 16px;
    }

    .hero-content h2 {
        font-size: 38px;
    }

    .hero-content p {
        font-size: 18px;
    }

    .property-image {
        height: 245px;
    }

    .property-info {
        padding: 23px;
    }

    .property-info h3 {
        font-size: 23px;
    }

    .property-info strong {
        font-size: 25px;
    }

    .details-info h2 {
        font-size: 32px;
    }
}

/* =====================================================
   PROPERTY DETAILS BUTTON - PREMIUM
===================================================== */

.property-details-button {
    min-height: 52px;
    padding: 12px 24px;

    border: 2px solid var(--merlot);
    border-radius: 12px;

    background: var(--merlot);
    color: var(--bone);

    font-size: 17px;
    font-weight: 800;

    cursor: pointer;

    display: inline-flex;
    align-items: center;
    justify-content: center;

    transition:
        background-color 0.25s ease,
        color 0.25s ease,
        border-color 0.25s ease,
        transform 0.25s ease,
        box-shadow 0.25s ease;

    box-shadow:
        0 6px 18px rgba(75, 30, 35, 0.20);
}

.property-details-button:hover {
    background: var(--midnight-blue);
    border-color: var(--midnight-blue);

    color: var(--bone);

    transform: translateY(-3px);

    box-shadow:
        0 10px 24px rgba(28, 36, 48, 0.25);
}

.property-details-button:active {
    transform: translateY(-1px);
}



/* =====================================================
   SOLD / RENTED PROPERTY CARDS
===================================================== */

.property-card.property-completed {
    border: 2px solid #6B8E6B;

    background:
        linear-gradient(
            180deg,
            var(--bone) 0%,
            rgba(107, 142, 107, 0.08) 100%
        );
}


/* لون حالة العقار */

.property-card.property-completed .property-status {
    background: #6B8E6B;
    color: var(--bone);

    border-color: #6B8E6B;
}


/* زر التفاصيل في العقار المكتمل */

.property-card.property-completed
.property-details-button {
    background: #4F7654;
    border-color: #4F7654;
}

.property-card.property-completed
.property-details-button:hover {
    background: #3F6044;
    border-color: #3F6044;
}


/* =====================================================
   SOLD / RENTED BADGE ON IMAGE
===================================================== */

.property-image {
    position: relative;
}


.completed-badge {
    position: absolute;

    top: 18px;
    right: 18px;

    z-index: 5;

    min-width: 105px;

    padding: 10px 18px;

    border-radius: 10px;

    color: var(--bone);

    font-size: 16px;
    font-weight: 900;

    text-align: center;

    letter-spacing: 0.3px;

    box-shadow:
        0 6px 18px rgba(18, 18, 18, 0.22);
}


.sold-badge,
.rented-badge {
    background: #4F7654;
}


/* =====================================================
   SOLD / RENTED CARD PRICE
===================================================== */

.property-card.property-completed
.property-card-bottom strong {
    color: #4F7654;
}


/* =====================================================
   COMPLETED CARD HOVER
===================================================== */

.property-card.property-completed:hover {
    border-color: #4F7654;

    box-shadow:
        0 18px 40px rgba(79, 118, 84, 0.18);

    transform: translateY(-5px);
}


/* =====================================================
   STATUS BADGE NORMAL
===================================================== */

.property-card:not(.property-completed)
.property-status {
    transition:
        transform 0.25s ease,
        box-shadow 0.25s ease;
}


/* =====================================================
   MOBILE
===================================================== */

@media (max-width: 600px) {

    .property-details-button {
        min-height: 50px;

        padding:
            11px 18px;

        font-size: 16px;
    }

    .completed-badge {
        top: 12px;
        right: 12px;

        min-width: 90px;

        padding:
            8px 13px;

        font-size: 14px;
    }

}

/* =========================
   PROPERTY WHATSAPP BUTTON
========================= */

.property-whatsapp-button {
    display: inline-flex !important;
    align-items: center;
    justify-content: center;
    gap: 8px;

    min-height: 58px;
    padding: 0 26px;

    border-radius: 13px;

    background: var(--olive);
    color: var(--bone) !important;

    text-decoration: none !important;

    font-size: 17px;
    font-weight: 800;

    box-shadow: var(--shadow-sm);

    transition:
        transform 0.25s ease,
        box-shadow 0.25s ease,
        background 0.25s ease;
}

.property-whatsapp-button:hover {
    transform: translateY(-3px);
    box-shadow: var(--shadow-md);
    background: #5f633f;
}
