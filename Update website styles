            );
    }

    .contact-info-cards {
        grid-template-columns:
            repeat(3, minmax(0, 1fr));
    }
}


/* =========================================================
   34. MOBILE
   ========================================================= */

@media (max-width: 700px) {

    body {
        font-size: 16px;
    }

    .container {
        width:
            calc(100% - 30px);
    }


    /* NAVBAR */

    nav {
        min-height: auto;

        flex-direction: column;

        align-items: center;

        gap: 12px;

        padding:
            17px 10px 14px;
    }

    nav > div:first-child {
        width: 100%;

        max-width: none;

        flex-direction: column;

        gap: 2px;

        text-align: center;
    }

    nav h1 {
        font-size: 28px;
        line-height: 1.3;
    }

    nav span {
        font-size: 14px;
    }

    nav > div:last-child {
        width: 100%;

        justify-content: center;

        gap: 4px 5px;
    }

    nav div a {
        min-height: 42px;

        padding:
            9px 10px;

        font-size: 15px;
        font-weight: 700;
    }


    /* HERO */

    .hero {
        min-height: 540px;

        padding:
            65px 15px;
    }

    .hero-content h2 {
        font-size: 36px;

        line-height: 1.4;
    }

    .hero-content p {
        font-size: 17px;

        line-height: 1.85;
    }


    /* SEARCH */

    .search-box {
        width: 100%;

        flex-direction: column;

        padding: 15px;

        gap: 10px;
    }

    .search-box select,
    .search-box input,
    .search-box button {
        width: 100%;

        min-width: 0;

        flex: none;

        font-size: 16px;
    }


    /* SECTIONS */

    .featured-properties {
        padding:
            65px 15px;
    }

    .featured-properties > h2 {
        font-size: 32px;
    }

    .featured-properties > p {
        font-size: 16px;
    }


    /* CARDS */

    .properties-container {
        grid-template-columns: 1fr;

        gap: 21px;

        margin-top: 32px;
    }

    .property-card {
        width: 100%;
    }

    .property-image {
        height: 235px;
    }

    .property-info {
        padding: 20px;
    }

    .property-info h3 {
        font-size: 21px;
    }

    .property-info p {
        font-size: 16px;
    }

    .property-info strong {
        font-size: 23px;
    }


    /* DETAILS */

    .property-details {
        width:
            calc(100% - 30px);

        margin:
            40px auto;

        gap: 28px;
    }

    .main-property-image {
        height:
            min(
                78vw,
                360px
            );
    }

    .property-data,
    .details-grid {
        grid-template-columns: 1fr;
    }

    .details-info h2 {
        font-size: 30px;
    }

    .details-info strong {
        font-size: 26px;
    }

    .details-info p {
        font-size: 16px;
    }

    .details-buttons {
        flex-direction: column;
    }

    .details-buttons a,
    .details-buttons button {
        width: 100%;
    }


    /* CONTACT */

    .contact-hero {
        min-height: 470px;

        padding:
            65px 15px;
    }

    .contact-hero h1,
    .contact-hero h2 {
        font-size: 38px;
    }

    .contact-hero p {
        font-size: 17px;
    }

    .contact-section,
    .map-section {
        width:
            calc(100% - 30px);

        margin-top: 50px;

        margin-bottom: 50px;
    }

    .contact-form-card,
    .contact-info-card {
        padding:
            25px 19px;
    }

    .contact-info-cards {
        grid-template-columns: 1fr;

        gap: 14px;
    }

    .map-card {
        min-height: 280px;

        padding: 10px;
    }

    .map-card iframe {
        min-height: 310px;
    }


    /* CTA */

    .cta-section {
        width:
            calc(100% - 30px);

        margin-bottom: 55px;

        padding:
            40px 20px;
    }

    .cta-buttons {
        flex-direction: column;
    }

    .cta-buttons .btn {
        width: 100%;
    }


    /* ABOUT */

    .about-section {
        width:
            calc(100% - 30px);

        margin:
            45px auto;

        padding:
            30px 20px;
    }

    .about-section h2 {
        font-size: 31px;
    }

    .about-section h3 {
        font-size: 23px;
    }

    .about-section p {
        font-size: 16px;
    }


    /* LOGIN */

    .login-container {
        width:
            calc(100% - 30px);

        margin:
            55px auto;

        padding:
            28px 18px;
    }


    /* FOOTER */

    .site-footer {
        margin-top: 50px;

        padding:
            45px 18px 20px;
    }

    .footer-content {
        grid-template-columns: 1fr;

        gap: 28px;

        text-align: center;
    }

    .footer-about p {
        max-width: none;
    }

    .footer-content a:hover {
        transform: none;
