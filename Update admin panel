    // =========================================

    function sortPropertiesByCode(properties) {

        return [...properties].sort((a, b) => {

            const codeA =
                String(a.property_code || "").trim().toUpperCase();

            const codeB =
                String(b.property_code || "").trim().toUpperCase();


            const numberA =
                parseInt(
                    codeA.replace(/^P/i, ""),
                    10
                );


            const numberB =
                parseInt(
                    codeB.replace(/^P/i, ""),
                    10
                );


            const validA =
                !isNaN(numberA);

            const validB =
                !isNaN(numberB);


            // العقارات التي لها كود صحيح أولًا

            if (validA && validB) {

                return numberA - numberB;

            }


            if (validA && !validB) {

                return -1;

            }


            if (!validA && validB) {

                return 1;

            }


            // لو مفيش كود، نستخدم property_id
            // كترتيب احتياطي ثابت

            return String(
                a.property_id || a.id || ""
            ).localeCompare(
                String(
                    b.property_id || b.id || ""
                )
            );

        });

    }


