<!DOCTYPE html>
<html lang="ar" dir="rtl">

<head>

    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>لوحة التحكم - مكتب علام للعقارات</title>

    <link rel="stylesheet" href="style.css">

    <script src="https://cdn.jsdelivr.net/npm/@supabase/supabase-js@2"></script>

    <style>

        /* =========================================
           لوحة التحكم
        ========================================= */

        .admin-container {
            max-width: 1200px;
            margin: 40px auto;
            background: #fff;
            padding: 35px;
            border-radius: 8px;
            box-shadow: 0 4px 15px rgba(0,0,0,0.1);
        }

        .admin-container h2 {
            margin-bottom: 20px;
            color: #b8955a;
            border-bottom: 2px solid #eee;
            padding-bottom: 12px;
            font-size: 30px;
        }

        .form-group {
            margin-bottom: 22px;
        }

        .form-group label {
            display: block;
            margin-bottom: 9px;
            font-weight: bold;
            color: #333;
            font-size: 19px;
        }

        .form-group input,
        .form-group select,
        .form-group textarea {
            width: 100%;
            padding: 15px;
            border: 1px solid #ddd;
            border-radius: 5px;
            font-size: 18px;
            outline: none;
            box-sizing: border-box;
        }

        .form-group textarea {
            resize: vertical;
            height: 120px;
        }

        .btn-save,
        .btn-cancel,
        .btn-edit,
        .btn-delete {
            border: none;
            padding: 13px 22px;
            font-size: 17px;
            font-weight: bold;
            border-radius: 5px;
            cursor: pointer;
        }

        .btn-save {
            background-color: #b8955a;
            color: #fff;
        }

        .btn-save:hover {
            background-color: #9c7c47;
        }

        .btn-cancel {
            background-color: #777;
            color: #fff;
            margin-right: 8px;
        }

        .btn-edit {
            background-color: #5b7fa3;
            color: white;
        }

        .btn-delete {
            background-color: #b94a48;
            color: white;
            margin-right: 5px;
        }

        #successMessage {
            display: none;
            background-color: #d4edda;
            color: #155724;
            padding: 16px;
            border-radius: 5px;
            margin-bottom: 20px;
            text-align: center;
            font-size: 18px;
        }

        #errorMessage {
            display: none;
            background-color: #f8d7da;
            color: #721c24;
            padding: 16px;
            border-radius: 5px;
            margin-bottom: 20px;
            text-align: center;
            font-size: 18px;
        }

        .note {
            font-size: 16px;
            color: #777;
            margin-top: 6px;
        }

        .section-title {
            margin-top: 50px;
            margin-bottom: 20px;
            color: #b8955a;
            border-bottom: 2px solid #eee;
            padding-bottom: 12px;
            font-size: 30px;
        }

        .property-admin-card {
            border: 1px solid #ddd;
            border-radius: 8px;
            padding: 22px;
            margin-bottom: 15px;
            background: #fafafa;
        }

        .property-admin-card h3 {
            margin: 0 0 12px;
            color: #333;
            font-size: 23px;
        }

        .property-admin-info {
            color: #666;
            line-height: 2;
            margin-bottom: 14px;
            font-size: 18px;
        }

        .status-badge {
            display: inline-block;
            padding: 7px 13px;
            border-radius: 15px;
            font-size: 16px;
            font-weight: bold;
            margin-bottom: 11px;
        }

        .status-sale {
            background: #e8f5e9;
            color: #2e7d32;
        }

        .status-rent {
            background: #e3f2fd;
            color: #1565c0;
        }

        .status-sold {
            background: #ffebee;
            color: #c62828;
        }

        .status-rented {
            background: #fff3e0;
            color: #ef6c00;
        }

        .empty-properties {
            text-align: center;
            color: #777;
            padding: 30px;
            border: 1px dashed #ccc;
            border-radius: 8px;
            font-size: 18px;
        }

        .english-section {
            margin-top: 35px;
            padding: 25px;
            border-top: 2px solid #eee;
            background: #fafafa;
            border-radius: 8px;
        }

        .english-section h3 {
            color: #b8955a;
            margin-bottom: 20px;
            font-size: 24px;
        }

        .auto-field {
            background-color: #f1f1f1;
            color: #555;
            cursor: not-allowed;
        }

        .english-note {
            background: #fff8e8;
            border-right: 4px solid #b8955a;
            padding: 15px;
            margin-bottom: 20px;
            color: #666;
            line-height: 1.8;
            font-size: 17px;
        }

        /* البيانات الداخلية */

        .private-section {
            margin-top: 35px;
            padding: 25px;
            background: #f8f8f8;
            border: 1px solid #e5e5e5;
            border-right: 4px solid #b8955a;
            border-radius: 8px;
        }

        .private-section h3 {
            color: #b8955a;
            margin-top: 0;
            margin-bottom: 10px;
            font-size: 24px;
        }

        .private-note {
            background: #fff8e8;
            padding: 15px;
            border-radius: 5px;
            color: #666;
            line-height: 1.8;
            margin-bottom: 20px;
            font-size: 16px;
        }

        .private-info-card {
            margin-top: 15px;
            padding: 18px;
            background: #fff8e8;
            border-radius: 6px;
            border: 1px solid #ead9b5;
            line-height: 2;
            color: #555;
            font-size: 17px;
        }


        /* =========================================
           جدول العقارات
        ========================================= */

        .properties-table-section {
            margin-top: 45px;
        }

        .properties-table-wrapper {
            width: 100%;
            overflow-x: auto;
            border: 1px solid #ddd;
            border-radius: 8px;
            background: #fff;
        }

        .properties-table {
            width: 100%;
            min-width: 1100px;
            border-collapse: collapse;
            font-size: 17px;
        }

        .properties-table th {
            background: #f4f0e9;
            color: #4b1e23;
            font-weight: bold;
            padding: 17px 14px;
            border-bottom: 2px solid #b8955a;
            text-align: center;
            white-space: nowrap;
            font-size: 18px;
        }

        .properties-table td {
            padding: 16px 14px;
            border-bottom: 1px solid #eee;
            text-align: center;
            vertical-align: middle;
            color: #444;
            line-height: 1.8;
            font-size: 17px;
        }

        .properties-table tbody tr:hover {
            background: #faf8f4;
        }

        .properties-table tbody tr:last-child td {
            border-bottom: none;
        }

        .table-code {
            font-weight: bold;
            color: #b8955a;
            white-space: nowrap;
            font-size: 18px;
        }

        .table-property-title {
            font-weight: bold;
            color: #333;
            min-width: 170px;
            font-size: 18px;
        }

        .table-actions {
            white-space: nowrap;
        }

        .table-actions button {
            border: none;
            padding: 10px 14px;
            border-radius: 5px;
            cursor: pointer;
            font-size: 16px;
            font-weight: bold;
        }

        .table-edit {
            background: #5b7fa3;
            color: #fff;
        }

        .table-delete {
            background: #b94a48;
            color: #fff;
            margin-right: 4px;
        }

        .table-private {
            text-align: right !important;
            min-width: 180px;
            font-size: 16px !important;
        }

        .table-private strong {
            color: #4b1e23;
            font-size: 17px;
        }

        .table-empty {
            text-align: center !important;
            padding: 35px !important;
            color: #777;
            font-size: 18px !important;
        }


        /* =========================================
           الموبايل
        ========================================= */

        @media (max-width: 768px) {

            .admin-container {
                margin: 20px 10px;
                padding: 20px 15px;
            }

            .admin-container h2,
            .section-title {
                font-size: 25px;
            }

            .form-group label {
                font-size: 18px;
            }

            .form-group input,
            .form-group select,
            .form-group textarea {
                font-size: 17px;
            }

            .property-admin-card h3 {
                font-size: 20px;
            }

            .property-admin-info {
                font-size: 17px;
            }

            .properties-table th {
                font-size: 17px;
            }

            .properties-table td {
                font-size: 16px;
            }

        }

    </style>

</head>


<body>

    <nav>

        <div>
            <h1>مكتب علام</h1>
            <span>لوحة التحكم الإدارية</span>
        </div>

    </nav>


    <div class="admin-container">

        <h2 id="formTitle">
            إضافة عقار جديد
        </h2>


        <div id="successMessage"></div>

        <div id="errorMessage"></div>


        <form id="addPropertyForm">


            <!-- نوع العقار -->

            <div class="form-group">

                <label>نوع العقار *</label>

                <select id="propType" required>

                    <option value="شقة سكنية">شقة سكنية</option>
                    <option value="شقة إدارية">شقة إدارية</option>
                    <option value="محل تجاري">محل تجاري</option>
                    <option value="أرض">أرض</option>
                    <option value="مصانع ومخازن">مصانع ومخازن</option>
                    <option value="منزل">منزل</option>

                </select>

            </div>


            <!-- حالة العقار -->

            <div class="form-group">

                <label>حالة العقار *</label>

                <select id="propStatus" required>

                    <option value="للبيع">للبيع</option>
                    <option value="للإيجار">للإيجار</option>
                    <option value="تم البيع">تم البيع</option>
                    <option value="تم التأجير">تم التأجير</option>

                </select>

            </div>


            <!-- المنطقة -->

            <div class="form-group">

                <label>المنطقة *</label>

                <select id="propLocation" required>

                    <option value="">اختر المنطقة</option>

                    <option value="السبع بنات">السبع بنات</option>
                    <option value="شكرى القوتلي">شكرى القوتلي</option>
                    <option value="الشعبية">الشعبية</option>
                    <option value="الجمهورية">الجمهورية</option>
                    <option value="سكة زفتى">سكة زفتى</option>
                    <option value="طريق نادي الشرطة">طريق نادي الشرطة</option>
                    <option value="البندر">البندر</option>
                    <option value="المستشار">المستشار</option>
                    <option value="الزراعة">الزراعة</option>
                    <option value="مكتب العمل">مكتب العمل</option>
                    <option value="ابو راضي">ابو راضي</option>
                    <option value="عزبة خضر">عزبة خضر</option>
                    <option value="سوق اللبن">سوق اللبن</option>
                    <option value="الوراقة">الوراقة</option>
                    <option value="السكة الوسطانية">السكة الوسطانية</option>
                    <option value="منشية السلام">منشية السلام</option>
                    <option value="محب">محب</option>
                    <option value="المشحمة">المشحمة</option>
                    <option value="الشون">الشون</option>
                    <option value="المنشية الجديدة">المنشية الجديدة</option>
                    <option value="الشيشتاوي">الشيشتاوي</option>
                    <option value="نادي البلدية">نادي البلدية</option>
                    <option value="تقسيم الشامي">تقسيم الشامي</option>
                    <option value="عادل الرفاعي">عادل الرفاعي</option>
                    <option value="المنصورة القديمة">المنصورة القديمة</option>
                    <option value="الدواخلية">الدواخلية</option>
                    <option value="شارع الترعة">شارع الترعة</option>
                    <option value="شارع البحر">شارع البحر</option>
                    <option value="محلة البرج">محلة البرج</option>

                </select>

            </div>


            <!-- English Information -->

            <div class="english-section">

                <h3>English Property Information</h3>

                <div class="english-note">

                    الاختيارات الإنجليزية يتم إنشاؤها تلقائيًا
                    من الاختيارات العربية بالأعلى.
                    <br>
                    لا تحتاجين إلى اختيارها مرة أخرى.

                </div>


                <div class="form-group">

                    <label>Property Title (English)</label>

                    <input
                        type="text"
                        id="propTitleEn"
                        class="auto-field"
                        readonly
                        placeholder="سيتم إنشاؤه تلقائيًا">

                </div>


                <div class="form-group">

                    <label>Property Type (English)</label>

                    <select
                        id="propTypeEn"
                        class="auto-field"
                        disabled>

                        <option value="">
                            سيتم اختياره تلقائيًا
                        </option>

                        <option value="Residential Apartment">
                            Residential Apartment
                        </option>

                        <option value="Administrative Apartment">
                            Administrative Apartment
                        </option>

                        <option value="Commercial Shop">
                            Commercial Shop
                        </option>

                        <option value="Land">
                            Land
                        </option>

                        <option value="Factories and Warehouses">
                            Factories and Warehouses
                        </option>

                        <option value="House">
                            House
                        </option>

                    </select>

                </div>


                <div class="form-group">

                    <label>Location (English)</label>

                    <input
                        type="text"
                        id="propLocationEn"
                        class="auto-field"
                        readonly
                        placeholder="سيتم إنشاؤه تلقائيًا">

                </div>


                <div class="form-group">

                    <label>Description (English)</label>

                    <textarea
                        id="propDetailsEn"
                        placeholder="Write the property details in English..."></textarea>

                    <div class="note">

                        يمكنك كتابة الوصف الإنجليزي يدويًا إذا أردتِ،
                        وإذا تركتيه فارغًا سيتم وضع وصف افتراضي.

                    </div>

                </div>

            </div>


            <!-- السعر -->

            <div class="form-group">

                <label>السعر</label>

                <input
                    type="number"
                    id="propPrice"
                    placeholder="مثال: 1500000">

                <div class="note">
                    اكتبي الرقم فقط بدون كلمة جنيه.
                </div>

            </div>


            <!-- طريقة عرض السعر -->

            <div class="form-group">

                <label>طريقة عرض السعر</label>

                <select id="propPriceType">

                    <option value="total">سعر العقار بالكامل</option>
                    <option value="meter">سعر المتر</option>
                    <option value="monthly">سعر شهري</option>
                    <option value="yearly">سعر سنوي</option>

                </select>

            </div>


            <!-- ملاحظة السعر -->

            <div class="form-group">

                <label>ملاحظة إضافية للسعر</label>

                <input
                    type="text"
                    id="propPriceNote"
                    placeholder="مثال: قابل للتفاوض - السعر يبدأ من - أو أي ملاحظة">

                <div class="note">
                    هذه الخانة اختيارية ويمكن تركها فارغة.
                </div>

            </div>


            <!-- فئة السعر -->

            <div class="form-group">

                <label>فئة السعر</label>

                <select id="propPriceCategory">

                    <option value="all">غير محدد</option>
                    <option value="less-5k">أقل من 5 آلاف</option>
                    <option value="5k-10k">5 آلاف - 10 آلاف</option>
                    <option value="10k-20k">10 آلاف - 20 ألف</option>
                    <option value="20k-50k">20 ألف - 50 ألف</option>
                    <option value="50k-100k">50 ألف - 100 ألف</option>
                    <option value="100k-500k">100 ألف - 500 ألف</option>
                    <option value="500k-1m">500 ألف - مليون</option>
                    <option value="1m-2m">مليون - 2 مليون</option>
                    <option value="2m-3m">2 مليون - 3 مليون</option>
                    <option value="more-3m">أكثر من 3 مليون</option>

                </select>

            </div>


            <!-- المساحة -->

            <div class="form-group">

                <label>المساحة (م²)</label>

                <input
                    type="number"
                    id="propArea"
                    placeholder="مثال: 150">

            </div>


            <!-- فئة المساحة -->

            <div class="form-group">

                <label>فئة المساحة</label>

                <select id="propAreaCategory">

                    <option value="all">غير محدد</option>
                    <option value="less-100">أقل من 100 م²</option>
                    <option value="100-150">100 - 150 م²</option>
                    <option value="150-200">150 - 200 م²</option>
                    <option value="200-300">200 - 300 م²</option>
                    <option value="more-300">أكثر من 300 م²</option>

                </select>

            </div>


            <!-- الغرف -->

            <div class="form-group">

                <label>عدد الغرف</label>

                <input
                    type="number"
                    id="propRooms"
                    placeholder="مثال: 3">

            </div>


            <!-- الحمامات -->

            <div class="form-group">

                <label>عدد الحمامات</label>

                <input
                    type="number"
                    id="propBathrooms"
                    placeholder="مثال: 2">

            </div>


            <!-- الدور -->

            <div class="form-group">

                <label>الدور</label>

                <select id="propFloor">

                    <option value="">اختر الدور</option>

                    <option value="الأرضي">الأرضي</option>
                    <option value="الأول">الأول</option>
                    <option value="الثاني">الثاني</option>
                    <option value="الثالث">الثالث</option>
                    <option value="الرابع">الرابع</option>
                    <option value="الخامس">الخامس</option>
                    <option value="السادس">السادس</option>
                    <option value="السابع">السابع</option>
                    <option value="الثامن">الثامن</option>
                    <option value="التاسع">التاسع</option>
                    <option value="العاشر">العاشر</option>
                    <option value="الأخير">الأخير</option>

                </select>

            </div>


            <!-- التشطيب -->

            <div class="form-group">

                <label>التشطيب</label>

                <select id="propFinishing">

                    <option value="">اختر مستوى التشطيب</option>

                    <option value="بدون تشطيب">بدون تشطيب</option>
                    <option value="على الطوب الأحمر">على الطوب الأحمر</option>
                    <option value="نصف تشطيب">نصف تشطيب</option>
                    <option value="تشطيب كامل">تشطيب كامل</option>
                    <option value="تشطيب سوبر لوكس">تشطيب سوبر لوكس</option>
                    <option value="تشطيب فاخر">تشطيب فاخر</option>

                </select>

            </div>


            <!-- الصور -->

            <div class="form-group">

                <label>روابط الصور *</label>

                <input
                    type="text"
                    id="propImages"
                    placeholder="property1.jpg, property2.jpg"
                    value="property1.jpg"
                    required>

            </div>


            <!-- الوصف العربي -->

            <div class="form-group">

                <label>
                    الوصف التفصيلي للعقار
                </label>

                <textarea
                    id="propDetails"
                    placeholder="اكتب تفاصيل العقار هنا..."></textarea>

            </div>


            <!-- بيانات صاحب العقار -->

            <div class="private-section">

                <h3>
                    🔒 بيانات صاحب العقار
                </h3>

                <div class="private-note">

                    هذه البيانات خاصة بالمكتب وتُحفظ في قاعدة بيانات
                    منفصلة عن بيانات العقارات العامة.

                    <br>

                    لن يتم إرسالها إلى صفحات الموقع العامة.

                </div>


                <div class="form-group">

                    <label>اسم صاحب العقار</label>

                    <input
                        type="text"
                        id="ownerName"
                        placeholder="مثال: أحمد محمد">

                </div>


                <div class="form-group">

                    <label>رقم صاحب العقار</label>

                    <input
                        type="tel"
                        id="ownerPhone"
                        placeholder="مثال: 01xxxxxxxxx">

                </div>


                <div class="form-group">

                    <label>ملاحظات داخلية</label>

                    <textarea
                        id="internalNotes"
                        placeholder="اكتب أي ملاحظات خاصة بالمكتب عن هذا العقار..."></textarea>

                </div>

            </div>


            <!-- زر الحفظ -->

            <button
                type="submit"
                class="btn-save"
                id="saveButton">

                حفظ ونشر العقار

            </button>


            <button
                type="button"
                class="btn-cancel"
                id="cancelEditButton"
                style="display:none;">

                إلغاء التعديل

            </button>

        </form>


        <!-- العقارات الموجودة -->

        <h2 class="section-title">
            العقارات الموجودة
        </h2>

        <div id="propertiesList">

            <div class="empty-properties">
                جاري تحميل العقارات...
            </div>

        </div>


        <!-- الجدول -->

        <div class="properties-table-section">

            <h2 class="section-title">
                جدول جميع العقارات
            </h2>

            <div class="properties-table-wrapper">

                <table class="properties-table">

                    <thead>

                        <tr>

                            <th>الكود</th>
                            <th>العقار</th>
                            <th>الحالة</th>
                            <th>النوع</th>
                            <th>المنطقة</th>
                            <th>السعر</th>
                            <th>المساحة</th>
                            <th>الغرف</th>
                            <th>الحمامات</th>
                            <th>الدور</th>
                            <th>التشطيب</th>
                            <th>بيانات المالك</th>
                            <th>الإجراءات</th>

                        </tr>

                    </thead>

                    <tbody id="propertiesTableBody">

                        <tr>

                            <td colspan="13" class="table-empty">
                                جاري تحميل العقارات...
                            </td>

                        </tr>

                    </tbody>

                </table>

            </div>

        </div>

    </div>


<script>

