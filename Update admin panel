                else {

                    showSuccess(
                        "تم إضافة العقار وبيانات المالك بنجاح."
                    );

                }


                resetForm();

                loadProperties();

            }
        );


    // =========================================
    // تعديل عقار
    // =========================================

    async function editProperty(id) {

        const {
            data,
            error
        } =
            await supabaseClient
                .from("properties")
                .select("*")
                .eq(
                    "property_id",
                    id
                )
                .maybeSingle();


        if (error || !data) {

            showError(
                "لم نتمكن من العثور على العقار."
            );

            return;

        }


        const privateData =
            await getPrivatePropertyData(id);


        editingPropertyId =
            data.property_id;


        document.getElementById("formTitle")
            .textContent =
            "تعديل العقار";


        document.getElementById("propType")
            .value =
            data.property_type || "";


        document.getElementById("propStatus")
            .value =
            data.status || "للبيع";


        document.getElementById("propLocation")
            .value =
            data.location || "";


        updateEnglishFields();


        document.getElementById("propDetailsEn")
            .value =
            data.description_en || "";


        document.getElementById("propPrice")
            .value =
            data.price || "";


        document.getElementById("propPriceType")
            .value =
            data.price_type || "total";


        document.getElementById("propPriceNote")
            .value =
            data.price_note || "";


        document.getElementById("propPriceCategory")
            .value =
            data.price_category || "all";


        document.getElementById("propArea")
            .value =
            data.area || "";


        document.getElementById("propAreaCategory")
            .value =
            data.area_category || "all";


        document.getElementById("propRooms")
            .value =
            data.rooms || "";


        document.getElementById("propBathrooms")
            .value =
            data.bathrooms || "";


        document.getElementById("propFloor")
            .value =
            data.floor || "";


        document.getElementById("propFinishing")
            .value =
            data.finish || "";


        document.getElementById("propImages")
            .value =
            data.images || "";


        document.getElementById("propDetails")
            .value =
            data.description_ar || "";


        document.getElementById("ownerName")
            .value =
            privateData?.owner_name || "";


        document.getElementById("ownerPhone")
            .value =
            privateData?.owner_phone || "";


        document.getElementById("internalNotes")
            .value =
            privateData?.internal_notes || "";


        document.getElementById("saveButton")
            .textContent =
            "💾 حفظ التعديلات";


        document.getElementById("cancelEditButton")
            .style.display =
            "inline-block";


        window.scrollTo({
            top: 0,
            behavior: "smooth"
        });

    }


    // =========================================
    // حذف عقار
    // =========================================

    async function deleteProperty(id) {

        const confirmDelete =
            confirm(
                "هل أنتِ متأكدة من حذف هذا العقار؟"
            );


        if (!confirmDelete) {

            return;

        }


        const {
            error: privateDeleteError
        } =
            await supabaseClient
                .from("property_private")
                .delete()
                .eq(
                    "property_id",
                    id
                );


        if (privateDeleteError) {

            console.error(
                privateDeleteError
            );

            showError(
                "حدث خطأ أثناء حذف البيانات الخاصة: " +
                privateDeleteError.message
            );

            return;

        }


        const {
            error
        } =
            await supabaseClient
                .from("properties")
                .delete()
                .eq(
                    "property_id",
                    id
                );


        if (error) {

            console.error(error);

            showError(
                "حدث خطأ أثناء حذف العقار: " +
                error.message
            );

            return;

        }


        showSuccess(
            "تم حذف العقار وبياناته الخاصة بنجاح."
        );


        loadProperties();

    }


    // =========================================
    // إلغاء التعديل
    // =========================================

    document
        .getElementById("cancelEditButton")
        .addEventListener(
            "click",
            function() {

                resetForm();

            }
        );


    // =========================================
    // إعادة الفورم
    // =========================================

    function resetForm() {

        editingPropertyId =
            null;


        document
            .getElementById("addPropertyForm")
            .reset();


        document.getElementById("formTitle")
            .textContent =
            "إضافة عقار جديد";


        document.getElementById("saveButton")
            .textContent =
            "حفظ ونشر العقار";


        document.getElementById("cancelEditButton")
            .style.display =
            "none";


        document.getElementById("propImages")
            .value =
            "property1.jpg";


        document.getElementById("propPriceType")
            .value =
            "total";


        document.getElementById("propPriceCategory")
            .value =
            "all";


        document.getElementById("ownerName")
            .value =
            "";


        document.getElementById("ownerPhone")
            .value =
            "";


        document.getElementById("internalNotes")
            .value =
            "";


        updateEnglishFields();

    }


    // =========================================
    // تشغيل الصفحة
    // =========================================

    async function startAdmin() {

        const allowed =
            await checkAdminAccess();


        if (!allowed) {

            return;

        }


        updateEnglishFields();

        loadProperties();

    }


    startAdmin();

</script>

